manifest {
    name = 'JIAJZHAN-Kairos/PhylogicNDT'
    mainScript = 'main.nf'
    version = '0.2.1'
    nextflowVersion = '>=24.10.0'
    description = 'Sex-aware SASH/PURPLE preparation, Cluster, Timing and cohort LeagueModel'
}
params {
    input = null
    outdir = null
    container = null
    driver_genes = null
    cn_peaks = null
    expected_samples = 380
    cluster_iterations = 250
    league_permutations = 500
    league_seasons = 200
    seed = 20260813
}
process {
    container = params.container
    cpus = 2
    memory = '16 GB'
    time = '12h'
    maxForks = 20
    errorStrategy = { task.exitStatus in [137, 143, 104] ? 'retry' : 'terminate' }
    maxRetries = 2
}
env {
    MPLBACKEND = 'Agg'
    PYTHONHASHSEED = '0'
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MPLCONFIGDIR = '/tmp/matplotlib'
}
executor.queueSize = 20
profiles {
    aws { process.executor = 'awsbatch'; aws.region = 'ap-southeast-2'; aws.batch.maxSpotAttempts = 3 }
    local { process.executor = 'local'; docker.enabled = true; docker.runOptions = '--platform linux/amd64' }
}
